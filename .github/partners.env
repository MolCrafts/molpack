# The partner repositories molpack is built against. CI's pin is
# [partners] in .github/ci.toml (`molci partners` clones that ref into
# ../molrs). This file must name the same repository and ref;
# `scripts/partners.py check` fails when they disagree. `partners.py run`
# is the relock recipe below. A local `molci check` uses the sibling
# ../molrs and prints its branch and commit; it does not re-clone.
#
# KEY=VALUE lines only. SELF is this repository's directory name.
#
# On dev the ref is molrs's dev. CI does not look up a same-named branch.
# A release commit on master names the molrs release tag of the line
# Cargo.toml names, in this file and in ci.toml; release.yml clones that tag.
#
# Cargo.lock, python/Cargo.lock and python/uv.lock record molrs's package
# metadata (its version and dependencies), not a commit. When molrs's dev
# changes that metadata the lock gates fail; relock in a commit of its own:
#   scripts/partners.py run -- sh -c 'cargo update -w && (cd python && cargo update -w && uv lock) \
#     && cp Cargo.lock "$PARTNERS_SOURCE/" && cp python/Cargo.lock python/uv.lock "$PARTNERS_SOURCE/python/"'
SELF=molpack
# The checkout directory stays `molrs` (the partner key). The repository is
# the unified molpy project; its `dev` is the 0.20 API line.
MOLRS_REPOSITORY=MolCrafts/molpy
MOLRS_REF=dev
