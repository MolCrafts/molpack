# The partner repositories molpack is built against. scripts/partners.py
# resolves them, for every workflow (molcrafts-ci's actions/setup-partners:
# `partners.py fetch`) and for the git hooks (`partners.py run`) alike, so a
# local push is built and tested against the same molpy commit as CI -- never
# against whatever the sibling ../molpy happens to have checked out.
#
# KEY=VALUE lines only. SELF is this repository's directory in CI's sibling
# layout (molpack/, molpy/). Each <NAME>_REPOSITORY/<NAME>_REF pair is checked
# out as the directory <name> (lower case), so MOLPY_* lands in ../molpy and
# setup-partners exports its path as MOLPY_DIR.
#
# On dev, partners are tracked, not pinned: MOLPY_REF=dev is molpy's dev tip
# -- or molpy's branch of the same name as the one being built, when molpy has
# one (a change spanning both repositories; see "Partners" in
# CONTRIBUTING.md). A release commit on master names the molpy release tag of
# the line Cargo.toml names instead; release.yml builds the wheels and the
# crate against it.
#
# Cargo.lock, python/Cargo.lock and python/uv.lock record the molpy
# checkout's package metadata (versions and dependencies of molcrafts-molrs,
# molcrafts-molrs-ffi, molcrafts-molpy), not a commit. When molpy's dev
# changes that metadata the lock gates fail; relock in a commit of its own:
#   scripts/partners.py run -- sh -c 'cargo update -w && (cd python && cargo update -w && uv lock) \
#     && cp Cargo.lock "$PARTNERS_SOURCE/" && cp python/Cargo.lock python/uv.lock "$PARTNERS_SOURCE/python/"'
SELF=molpack
MOLPY_REPOSITORY=MolCrafts/molpy
MOLPY_REF=v0.20.0
