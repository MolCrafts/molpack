# Exact molpy source used by every CI and release build. Capsule fingerprints
# include the molrs source, so both Python wheels must embed this revision.
# Local builds use the sibling ../molpy checkout; check it out at MOLPY_REF.
#
# Relock package metadata after changing this revision:
#   cargo update -w
#   cd python && cargo update -w && uv lock
SELF=molpack
MOLPY_REPOSITORY=MolCrafts/molpy
MOLPY_REF=70f4c67d83510fd811291013c7e93d454e5cadfc
